# Database configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/nerlogix
SPRING_DATASOURCE_USERNAME=nerlogix
SPRING_DATASOURCE_PASSWORD=nerlogix_password

# JWT Secret (at least 32 characters for production)
NERLOGIX_JWT_SECRET=replace_with_a_secure_jwt_secret_at_least_32_chars_long_nerlogix2026

# CORS Allowed Origins (comma separated)
NERLOGIX_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Uploads directory
NERLOGIX_UPLOADS_DIR=./uploads

# Weather & Simulation flags
NERLOGIX_WEATHER_AUTO_FETCH=true
NERLOGIX_SIMULATION_ENABLED=true
NERLOGIX_SIMULATION_TICK_MS=3000

# Google Maps API Keys
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=
GOOGLE_ROUTES_API_KEY=
GOOGLE_E2E_KEY=
